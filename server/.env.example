# ==================== SERVER ====================
PORT=5000
MONGODB_URI=mongodb://localhost:27017/knshop
NODE_ENV=development
BASE_URL=http://localhost:5000

# ==================== JWT ====================
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
# ใช้ secret แยกสำหรับ refresh token (แนะนำ)
# REFRESH_TOKEN_SECRET=ANOTHER_LONG_RANDOM_STRING

# ==================== ADMIN ====================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@knshop.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# ==================== EMAIL (สำหรับ OTP) ====================
# วิธีที่ 1: Gmail App Password
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-app-password

# วิธีที่ 2: SMTP ทั่วไป (SendGrid, Mailgun, etc.)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# Email From
EMAIL_FROM_NAME=KN Shop
# EMAIL_FROM=noreply@knshop.com

# ==================== GOOGLE OAuth ====================
# สร้างที่ https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ==================== FACEBOOK OAuth ====================
# สร้างที่ https://developers.facebook.com/apps/
# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# ==================== SSL/HTTPS ====================
# SSL_ENABLED=true
# SSL_CERT_PATH=./ssl/fullchain.pem
# SSL_KEY_PATH=./ssl/privkey.pem
# SSL_CA_PATH=./ssl/chain.pem

# ==================== CLOUDFLARE ====================
# ตั้งเป็น true เมื่อใช้ Cloudflare Proxy
# TRUST_PROXY=true

# ==================== CORS ====================
# CORS_ORIGIN=https://your-domain.com

# ==================== LINE MESSAGING API ====================
# ใช้สำหรับ broadcast แจ้งเตือนและตรวจลายเซ็น webhook
# LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token
# ใส่ User ID เพื่อส่งตรงหาแอดมิน (ขึ้นต้นด้วย U) ถ้าไม่ใส่จะ broadcast
# LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# หลายคนใช้ LINE_USER_IDS=Uxxx,Uyyy
# ไม่แนะนำสำหรับ log ร้าน เพราะจะส่งข้อมูลให้เพื่อนบอททุกคน
# LINE_BROADCAST_ENABLED=false
# LINE_CHANNEL_SECRET=your-channel-secret
